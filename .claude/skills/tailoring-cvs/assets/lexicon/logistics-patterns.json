  {"kind": "salary_term", "regex": "\\b(?:base\\s+salary|salary|total\\s+comp(?:ensation)?|compensation|pay\\s+range|pay\\s+band|hourly\\s+rate|day\\s+rate|OTE)\\b[^.\\n]{0,40}?(?:[$€£]\\s?\\d|\\b\\d{2,3},\\d{3}\\b|\\b\\d{2,3}\\s?[kK]\\b)"},
