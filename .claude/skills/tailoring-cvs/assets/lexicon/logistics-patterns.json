[
  {"kind": "salary_range", "regex": "[$€£]\\s?\\d[\\d,]*(?:\\.\\d+)?\\s?[kK]?\\s?(?:-|–|—|to)\\s?[$€£]?\\s?\\d[\\d,]*(?:\\.\\d+)?\\s?[kK]?\\b"},
