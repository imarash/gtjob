  {"kind": "sponsorship", "regex": "\\b(?:visa|work|employer|immigration)\\s+sponsorship\\b|\\bsponsor(?:ed|ing)?\\s+(?:a\\s+|your\\s+|my\\s+)?(?:work\\s+)?(?:visa|permit)s?\\b|\\brequires?\\s+sponsorship\\b|\\bsponsorship\\s+(?:is\\s+)?(?:required|available|not)\\b"},
  {"kind": "relocation", "regex": "\\b(?:willing|open|able|ready|available)\\s+to\\s+relocate\\b|\\brelocation\\s+(?:assistance|package|support|required|bonus|expenses?)\\b|\\b(?:will|would|can|must)\\s+relocate\\b"},
  {"kind": "onsite_days", "regex": "\\b\\d\\s*(?:-\\s*\\d\\s*)?days?\\s*(?:per|a|each|/)\\s*week\\b"},
  {"kind": "onsite_days", "regex": "\\b(?:on-?site|in[- ]office|hybrid)\\b[^.\\n]{0,30}\\b\\d\\s*days?\\b"},
