  {"kind": "visa", "regex": "\\b(?:work|student|tourist|immigration|business|travel)\\s+visas?\\b|\\bvisas?\\s+(?:sponsorship|status|required|requirement|holder|transfer|support)\\b|\\bH-?1B\\b|\\bgreen\\s+card\\b|\\bwork\\s+permit\\b"},
